        <mxCell id="e5" value="groupe, affectation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="sess" target="mod">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="lit le groupe ; crée une affectation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="naif" target="mod">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="évalue sans modifier" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="calc" target="mod">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="SessionAffectation copie le résultat du solveur : elle garde sa propre affectation et un seul niveau d'annulation.&#10;CalculateurJalousie ne modifie ni le groupe ni l'affectation. Aucun de ces services ne connaît la console ni Swing." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="830" width="1700" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
