  <diagram name="1 Modèle" id="1">
    <mxGraphModel dx="1450" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1450" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Modèle métier (package modele)&#10;Attributs principaux et opérations publiques ; constructeurs et validations privées omis." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="25" width="1250" height="55" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;Groupe&lt;/b&gt;&lt;hr&gt;- personnesParNom : Map&amp;lt;String, Personne&amp;gt;&lt;br&gt;- chambres : List&amp;lt;Chambre&amp;gt;&lt;br&gt;- relations : Map&amp;lt;Personne, Set&amp;lt;Personne&amp;gt;&amp;gt;&lt;br&gt;- preferencesParPersonne : Map&amp;lt;Personne, Preferences&amp;gt;&lt;hr&gt;+ getPersonne(nom) : Personne&lt;br&gt;+ getPersonnes() : List&amp;lt;Personne&amp;gt;&lt;br&gt;+ getChambres() : List&amp;lt;Chambre&amp;gt;&lt;br&gt;+ ajouterRelation(a, b) : void&lt;br&gt;+ getVoisins(p) : Set&amp;lt;Personne&amp;gt;&lt;br&gt;+ definirPreferences(p, preferences) : void&lt;br&gt;+ getPreferences(p) : Preferences&lt;br&gt;+ personnesSansPreferences() : List&amp;lt;Personne&amp;gt;&lt;br&gt;+ estComplet() : boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="120" width="540" height="380" />
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;Affectation&lt;/b&gt;&lt;hr&gt;- chambresParPersonne : Map&amp;lt;Personne, Chambre&amp;gt;&lt;hr&gt;+ chambreDe(personne) : Chambre&lt;br&gt;+ echanger(a, b) : void&lt;br&gt;+ estValidePour(groupe) : boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="120" width="470" height="210" />
        </mxCell>
        <mxCell id="p" value="&lt;b&gt;Personne&lt;/b&gt;&lt;hr&gt;- nom : String {final}&lt;hr&gt;+ getNom() : String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="570" width="290" height="150" />
        </mxCell>
        <mxCell id="pref" value="&lt;b&gt;Preferences&lt;/b&gt;&lt;hr&gt;- classement : List&amp;lt;Chambre&amp;gt; {final}&lt;br&gt;- rangsParChambre : Map&amp;lt;Chambre, Integer&amp;gt; {final}&lt;hr&gt;+ getClassement() : List&amp;lt;Chambre&amp;gt;&lt;br&gt;+ rangDe(chambre) : int&lt;br&gt;+ prefere(a, b) : boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="570" width="450" height="220" />
        </mxCell>
        <mxCell id="c" value="&lt;b&gt;Chambre&lt;/b&gt;&lt;hr&gt;- numero : int {final}&lt;hr&gt;+ getNumero() : int" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="570" width="290" height="150" />
        </mxCell>
        <mxCell id="g-p" value="membres : n ; relations entre membres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="g" target="p">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="g-pref" value="0..1 classement par membre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="g" target="pref">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="g-c" value="chambres : n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="g" target="c">
