          <mxGeometry as="geometry" x="1220" y="400" width="540" height="140" />
        </mxCell>
        <mxCell id="mod" value="&lt;b&gt;modele&lt;/b&gt;&lt;hr&gt;Groupe, Personne, Chambre, Preferences, Affectation&lt;hr&gt;Données et règles de validation (aucune dépendance vers les autres packages)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#dae8fc;strokeColor=#536579;" vertex="1" parent="1">
