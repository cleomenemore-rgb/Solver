  <diagram name="2 Résolution et services" id="2">
    <mxGraphModel dx="1450" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Résolution et services (packages algorithme et service)&#10;Flèche pointillée : utilise ; triangle creux : implémente ; flèche pleine : référence conservée dans un attribut." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1500" height="55" />
        </mxCell>
        <mxCell id="itf" value="&lt;b&gt;« interface » SolveurAffectation&lt;/b&gt;&lt;hr&gt;+ resoudre(groupe : Groupe) : Affectation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#536579;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="120" width="420" height="140" />
        </mxCell>
        <mxCell id="naif" value="&lt;b&gt;SolveurNaif&lt;/b&gt;&lt;hr&gt;+ resoudre(groupe : Groupe) : Affectation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#d5e8d4;strokeColor=#536579;" vertex="1" parent="1">
