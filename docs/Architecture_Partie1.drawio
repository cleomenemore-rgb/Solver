  <diagram name="3 Interfaces console et Swing" id="3">
    <mxGraphModel dx="1450" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1150">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Interfaces console et Swing (packages app, ui et ui.graphique)&#10;Les deux interfaces utilisent les mêmes services : il n'y a pas de règle de jalousie dans l'interface graphique." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
