        <mxCell id="pref-c" value="classement ordonné" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="pref" target="c">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a-g" value="valide le périmètre" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="a" target="g">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a-c" value="une chambre par personne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="a" target="c">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="Groupe porte les préférences et les relations ; Affectation porte la répartition.&#10;Personne, Chambre et Preferences sont immuables. Les collections exposées sont protégées." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="850" width="1250" height="55" />
